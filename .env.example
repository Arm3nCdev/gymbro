# OWNER_*: Owner (Dueño / Administración) account created on first start, when the
# database has no owner yet. Owner accounts can't be registered or recovered from the web.
OWNER_USERNAME="rony"
OWNER_NAME="Rony"
OWNER_PASSWORD="CHANGE_ME"

# GEMINI_API_KEY: Enables AI routines and messages (falls back to templates when missing).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT / HOST: Where the Express server listens (default 3000 on 0.0.0.0).
PORT=3000
HOST="0.0.0.0"
