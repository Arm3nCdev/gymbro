# OWNER_*: Owner (Dueño / Administración) account created on first start, when the
# database has no owner yet. Owner accounts can't be registered or recovered from the web.
# Demo credentials (admin / admin123): change OWNER_PASSWORD before going to production.
OWNER_USERNAME="admin"
OWNER_NAME="Administrador"
OWNER_PASSWORD="admin123"
# OWNER_ACCOUNTS: Extra owner accounts, "usuario:contraseña:Nombre" separated by ";".
OWNER_ACCOUNTS="demo:demo123:Dueño Demo"

# PLATFORM_ADMIN_*: platform panel at /plataforma (create, suspend and resume gyms).
PLATFORM_ADMIN_USER="plataforma"
PLATFORM_ADMIN_PASSWORD="CHANGE_ME"

# GEMINI_API_KEY: Enables AI routines and messages (falls back to templates when missing).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT / HOST: Where the Express server listens (default 3000 on 0.0.0.0).
PORT=3000
HOST="0.0.0.0"
